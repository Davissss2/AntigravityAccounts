{
  "name": "antigravity-account",
  "displayName": "Antigravity Account",
  "description": "Manage multiple Antigravity accounts seamlessly - switch, monitor credits, and auto-rotate with one click.",
  "version": "0.3.18",
  "publisher": "Davissss2",
  "author": {
    "name": "Davissss2",
    "url": "https://github.com/Davissss2"
  },
  "license": "MIT",
  "homepage": "https://github.com/Davissss2/AntigravityAccounts#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Davissss2/AntigravityAccounts.git"
  },
  "bugs": {
    "url": "https://github.com/Davissss2/AntigravityAccounts/issues"
  },
  "qna": "https://github.com/Davissss2/AntigravityAccounts/discussions",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "antigravity",
    "antigravity hub",
    "antigravity account-manager",
    "antigravity multi-account",
    "antigravity accounts",
    "antigravity credits",
    "antigravity tokens",
    "antigravity model",
    "antigravity model balance",
    "antigravity balance",
    "antigravity ai",
    "antigravity google-ai",
    "antigravity credits",
    "account-manager",
    "google-ai",
    "credits",
    "multi-account"
  ],
  "activationEvents": [
    "onView:antigravity-account.accountsView",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icons/logo_with_title_bordered.png",
  "contributes": {
    "commands": [
      {
        "command": "antigravity-account.openPanel",
        "title": "Open Account Manager",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.addAccount",
        "title": "Add Account",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.switchAccount",
        "title": "Switch Account",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.refreshBalances",
        "title": "Refresh All Balances",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.setLanguage",
        "title": "Set Language",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.getAccounts",
        "title": "Get All Accounts (API)",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.getActiveAccount",
        "title": "Get Active Account (API)",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.autoSwitch",
        "title": "Auto-Switch to Best Quota Account",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.refreshActiveQuota",
        "title": "Refresh Active Account Quota",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.toggleAutoSwitch",
        "title": "Toggle Auto-Switch on Depletion",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.syncActiveAccount",
        "title": "Sync Native Antigravity Account",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.toggleAutoCapture",
        "title": "Toggle Auto-Capture of Native Logins",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.toggleAutoResume",
        "title": "Toggle Chat Auto-Resume on Depletion",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.reconcileAccounts",
        "title": "Reconcile Orphaned Accounts",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.getConfig",
        "title": "Get Configuration (API)",
        "category": "Antigravity Account"
      },
      {
        "command": "antigravity-account.updateConfig",
        "title": "Update Configuration (API)",
        "category": "Antigravity Account"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-account",
          "title": "Antigravity Account",
          "icon": "resources/icons/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-account": [
        {
          "type": "webview",
          "id": "antigravity-account.accountsView",
          "name": "Accounts",
          "icon": "resources/icons/sidebar-icon.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "antigravity-account.openPanel",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "antigravity-account.switchAccount",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "antigravity-account.addAccount",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "antigravity-account.refreshBalances",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "configuration": {
      "title": "Antigravity Account",
      "properties": {
        "antigravityAccount.theme": {
          "type": "string",
          "default": "dark-purple",
          "enum": [
            "dark-purple",
            "vscode",
            "midnight",
            "deep-blue"
          ],
          "enumDescriptions": [
            "Dark Purple (Original Theme)",
            "VS Code Theme (Adaptive to Editor)",
            "Midnight Black (Pure OLED Dark)",
            "Deep Ocean Blue"
          ],
          "description": "Visual theme for the extension panel"
        },
        "antigravityAccount.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "es",
            "zh-CN",
            "pt-BR",
            "fr",
            "de",
            "ja",
            "ru",
            "ko",
            "ar"
          ],
          "enumDescriptions": [
            "Auto (Detect from Editor)",
            "English",
            "Español",
            "中文 (简体)",
            "Português (Brasil)",
            "Français",
            "Deutsch",
            "日本語",
            "Русский",
            "한국어",
            "العربية"
          ],
          "description": "Display language for the extension UI"
        },
        "antigravityAccount.autoRefreshEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic balance refresh when opening the extension panel"
        },
        "antigravityAccount.refreshIntervalMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1440,
          "description": "Interval in minutes for automatic background balance refresh when auto-refresh is enabled (0 = Disabled)"
        },
        "antigravityAccount.activeQuotaRefreshIntervalSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 15,
          "maximum": 600,
          "description": "Polling interval in seconds for rapid quota monitoring and depletion detection of the currently active account (Default: 45s)"
        },
        "antigravityAccount.lowCreditThreshold": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "description": "Credit threshold for low balance warning"
        },
        "antigravityAccount.lowCreditNotificationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable native notifications when account credit balance falls below the threshold or gets depleted"
        },
        "antigravityAccount.autoRotateEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch to another account when the active account's credits are depleted"
        },
        "antigravityAccount.confirmOnSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Show confirmation modal before closing and reloading window on account switch (Default: false, reloads automatically without prompt)"
        },
        "antigravityAccount.noticeDurationSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 60,
          "description": "Notice duration in seconds shown before switching accounts (0 = instantaneous)"
        },
        "antigravityAccount.autoCaptureAccounts": {
          "type": "boolean",
          "default": false,
          "description": "Automatically detect and save accounts signed into Antigravity IDE without manual addition"
        },
        "antigravityAccount.showNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show verbose/frequent notifications (e.g. accounts auto-detected, refresh queues). When disabled, only essential manual action notices are shown."
        },
        "antigravityAccount.autoResumeChat": {
          "type": "boolean",
          "default": false,
          "description": "Automatically restore active chat session and continue AI generation after account rotation on depletion"
        },
        "antigravityAccount.autoResumePrompt": {
          "type": "string",
          "default": "continua",
          "description": "Prompt text automatically sent to the AI chat after account switch when previous generation stopped due to quota depletion"
        },
        "antigravityAccount.autoResumeTimeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 10,
          "maximum": 600,
          "description": "Maximum seconds elapsed since the last assistant message to consider that the AI was actively working and stopped due to quota"
        },
        "antigravityAccount.adaptiveQuotaPolling": {
          "type": "boolean",
          "default": true,
          "description": "Dynamically accelerates quota polling when active account quota drops below 10% (checks every 8s) to trigger immediate auto-switch without hitting rate limits"
        },
        "antigravityAccount.cacheDurationDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "description": "Number of days that scanned account balances are cached before requiring a refresh"
        },
        "antigravityAccount.sortBy": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "name-asc",
            "name-desc",
            "email-asc",
            "email-desc",
            "date-added",
            "quota",
            "quota-regen"
          ],
          "enumDescriptions": [
            "Default (Preferred model / Status)",
            "Name (A-Z)",
            "Name (Z-A)",
            "Email (A-Z)",
            "Email (Z-A)",
            "Date Added (Newest first)",
            "Remaining Quota (Highest first)",
            "Quota Regen Time (Soonest first)"
          ],
          "description": "Sorting order for accounts in the list"
        },
        "antigravityAccount.oauthClientId": {
          "type": "string",
          "default": "",
          "description": "Custom Google OAuth Client ID to prevent 7-day token expiration. Leave empty to use the default client."
        },
        "antigravityAccount.oauthClientSecret": {
          "type": "string",
          "default": "",
          "description": "Custom Google OAuth Client Secret (required if using custom Client ID)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx -y @vscode/vsce package",
    "package:win": "npx -y @vscode/vsce package --target win32-x64",
    "package:mac": "npx -y @vscode/vsce package --target darwin-arm64 --target darwin-x64",
    "package:linux": "npx -y @vscode/vsce package --target linux-x64",
    "package:all": "npm run package:win && npm run package:mac && npm run package:linux"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
